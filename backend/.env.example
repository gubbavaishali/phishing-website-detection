# Phishing Website Detection - Backend Environment Configuration

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=False
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Model Settings
MODEL_VERSION=1.0.0
MODEL_PATH=app/ml/trained_models/model.joblib
MODEL_METADATA_PATH=app/ml/trained_models/model_metadata.json

# Webpage Inspection & SSRF Protection
ENABLE_HTML_INSPECTION=True
HTTP_TIMEOUT_SECONDS=5.0
MAX_RESPONSE_SIZE_BYTES=1048576

# Supabase Persistence (Optional - falls back to local in-memory/sqlite store)
SUPABASE_URL=
SUPABASE_KEY=
USE_SUPABASE=False

# Threat Intelligence (Optional feed keys)
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
